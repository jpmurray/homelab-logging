        "legend": {
          "calcs": [
            "sum",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (host, service) (rate({cluster=\"saint-cluster\", location=~\"$location\", node=~\"$node\", host=~\"$host\", role=~\"$role\", job=~\"$job\", service=~\"$service\"} |~ \"(?i)(error|failed|fatal|panic)\" [$__interval])))",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{host}} / {{service}}"
        }
      ],
      "title": "Error-like log rate",
      "type": "timeseries"
    },
