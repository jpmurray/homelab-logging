// Complete Grafana Alloy configuration for the Saint-Cluster logging collector.
// This file can replace /etc/alloy/config.alloy as-is for the topology and
// Loki endpoint recorded in this repository.

loki.source.journal "local" {
  max_age    = "1h"
  forward_to = [loki.write.local.receiver]

  labels = {
    cluster  = "saint-cluster",
    host     = "alloy",
    location = "home",
    role     = "collector",
    job      = "journal",
  }
}

loki.relabel "homelab_syslog" {
  // Required even though the relabel component is used through its exported rules.
  forward_to = []

  // Compatibility defaults for Proxmox senders without structured data.
  rule {
    target_label = "cluster"
    replacement  = "saint-cluster"
  }

  rule {
    target_label = "location"
    replacement  = "home"
  }

  rule {
    target_label = "role"
    replacement  = "proxmox-host"
  }

  rule {
    target_label = "job"
    replacement  = "syslog"
  }

  // Legacy Proxmox-host senders use their syslog hostname as the node.
  // Structured LXC messages override this value below.
  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "node"
  }

  // Structured values emitted by homelab-logging override the defaults.
  rule {
    source_labels = ["__syslog_message_sd_homelab_32473_cluster"]
    regex         = "(.+)"
    target_label  = "cluster"
  }

  rule {
    source_labels = ["__syslog_message_sd_homelab_32473_location"]
    regex         = "(.+)"
    target_label  = "location"
  }

  rule {
    source_labels = ["__syslog_message_sd_homelab_32473_role"]
    regex         = "(.+)"
    target_label  = "role"
  }

  rule {
    source_labels = ["__syslog_message_sd_homelab_32473_node"]
    regex         = "(.+)"
    target_label  = "node"
  }

  rule {
    source_labels = ["__syslog_message_sd_homelab_32473_job"]
    regex         = "(.+)"
    target_label  = "job"
  }

  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }

  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "service"
  }
}

loki.source.syslog "homelab_tcp" {
  listener {
    address                = "0.0.0.0:1514"
    protocol               = "tcp"
    syslog_format          = "rfc5424"
    use_incoming_timestamp = true
    label_structured_data  = true
  }

  relabel_rules = loki.relabel.homelab_syslog.rules
  forward_to    = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki.lobster-great.ts.net:3100/loki/api/v1/push"
  }
}
